# Server Port (Render / cloud providers set this automatically)
PORT=5000

# Option 1: Cloud PostgreSQL with PostGIS (Supabase / Neon / Render) - RECOMMENDED
DATABASE_URL=postgresql://postgres:your_password@ep-xyz.region.neon.tech/lifelink?sslmode=require

# Option 2: Local PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=lifelink
DB_SSL=false

# Security (JWT secret key for auth tokens)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Frontend Origin for CORS & WebSockets (comma-separated if multiple, e.g. http://localhost:3000,https://lifelink.vercel.app)
CLIENT_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
